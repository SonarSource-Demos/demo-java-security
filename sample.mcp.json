{
  "mcpServers": {
    "sonarqube-mcp-with-cag": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "SONARQUBE_URL",
        "-e", "SONARQUBE_TOKEN",
        "-e", "SONARQUBE_ORG",
        "-e", "SONAR_SQ_PROJECT_KEY",
        "-e", "SONAR_SQ_BRANCH",
        "-e", "SONARQUBE_TOOLSETS",
        "-e", "SONARQUBE_ADVANCED_ANALYSIS_ENABLED",
        "-v", "<PUT_PATH_TO_LOCAL_FOLDER>:/app/mcp-workspace:rw",
        "sq-mcp-cag-beta:20260316-2734c53-arm64"
      ],
      "env": {
        "SONARQUBE_URL": "https://sonarcloud.io",
        "SONARQUBE_ORG": "sonar-solutions",
        "SONAR_SQ_PROJECT_KEY": "sonar-solutions_event-demo-java-security",
        "SONAR_SQ_BRANCH": "main",
        "SONARQUBE_TOOLSETS": "cag,projects,analysis",
        "SONARQUBE_ADVANCED_ANALYSIS_ENABLED": "true",
        "SONARQUBE_TOKEN":"<PUT_TOKEN>"
      }
    }
  }
}
